# SkillForge backend — environment template (placeholders only — never real secrets).
# Copy to .env for local dev: Copy-Item ".env.example" ".env"
# In Docker (DOCKER=true) dotenv loading is skipped and compose provides env.
# Rotate any credential that has previously appeared in repository history.

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Required by the backend.
JWT_SECRET=change-me-to-a-long-random-value-in-local-env

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

DATABASE_URL=postgresql://postgres:change-me-in-local-env@localhost:5432/skillforge?schema=public
REDIS_URL=redis://localhost:6379
