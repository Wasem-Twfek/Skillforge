# SkillForge — root environment template (placeholders only — never real secrets).
# Copy to .env for local docker Compose usage: Copy-Item ".env.example" ".env"
# Rotate any credential that has previously appeared in repository history.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=skillforge

# Required by the backend.
JWT_SECRET=change-me-to-a-long-random-value-in-local-env

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# Frontend build arg (Vite). Keep EMPTY: service paths already carry the /api
# prefix, so baking /api here would produce /api/api/* in production.
# Empty keeps requests origin-relative for nginx to proxy.
VITE_API_URL=
