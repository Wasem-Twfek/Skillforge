# SkillForge — root environment template (placeholders only — never real secrets).
# Copy to .env for local docker Compose usage: Copy-Item ".env.example" ".env"
# Treat any credential previously committed to git history as compromised — rotate it.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=skillforge

# Required for production compose. No default is provided intentionally —
# the backend fails fast at startup when JWT_SECRET is missing in production.
JWT_SECRET=change-me-to-a-long-random-value-in-local-env

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback

# Frontend build arg (Vite)
VITE_API_URL=/api
